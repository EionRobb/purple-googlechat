#include <windows.h>

#ifndef VERSION_TAG
#define VERSION_TAG 1,0,0,0
#endif

#define STRINGIFY(x) #x
#define STRINGIFY4(a,b,c,d) STRINGIFY(a.b.c.d)
#define TOSTRING(x) STRINGIFY4(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_TAG
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",       "Eion Robb"
            VALUE "FileDescription",   "Google Chat Plugin for Pidgin/libpurple"
            VALUE "FileVersion",       TOSTRING(VERSION_TAG)
            VALUE "InternalName",      "libgooglechat"
            VALUE "LegalCopyright",    "Copyright (C) Eion Robb - Licensed under GPL v3"
            VALUE "LegalTrademarks",   ""
            VALUE "OriginalFilename",  "libgooglechat.dll"
            VALUE "ProductName",       "Purple Google Chat"
            VALUE "ProductVersion",    TOSTRING(VERSION_TAG)
            VALUE "Comments",          "A replacement prpl for Google Chat in Pidgin/libpurple"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x1409, 1200
    END
END
